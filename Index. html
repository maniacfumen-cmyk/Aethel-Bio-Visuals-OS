<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aethel Bio-Visuals | Molecular Architecture</title>
    <style>
        :root { --accent: #00f2ff; --bg: #050505; }
        body { 
            margin: 0; background: var(--bg); color: white; font-family: 'Segoe UI', sans-serif;
            display: flex; justify-content: center; align-items: center; min-height: 100vh;
            background-image: radial-gradient(circle at center, #111 0%, #050505 100%);
        }
        .container {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 30px;
            padding: 50px;
            text-align: center;
            max-width: 600px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }
        h1 { font-weight: 200; letter-spacing: 5px; text-transform: uppercase; font-size: 1.1rem; color: var(--accent); }
        .render-frame {
            position: relative; margin: 30px 0; border-radius: 15px; overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        img { width: 100%; display: block; transition: transform 0.5s ease; }
        img:hover { transform: scale(1.05); }
        .info { font-size: 0.8rem; opacity: 0.5; text-transform: uppercase; letter-spacing: 2px; }
        .pipeline-status { margin-top: 20px; font-size: 0.7rem; color: #444; border-top: 1px solid #222; padding-top: 20px; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Aethel Bio-Visuals</h1>
        <div class="render-frame">
            <!-- This image is generated by your GitHub Action -->
            <img src="output_render.png" alt="Latest Molecular Glass Render">
        </div>
        <p class="info">PDB-to-Glass Automation Pipeline</p>
        <div class="pipeline-status">
            STATUS: <span style="color: #0f0;">ONLINE</span> | ENGINE: BLENDER CYCLES
        </div>
    </div>
</body>
</html>
